{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finbra-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // site compilado (npm run build em web/); rotas desconhecidas caem no index.html (React Router)
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/dados/*", "/api/*"]
  },
  // login da IA (Cloudflare Access): ACCESS_TEAM = <equipe>.cloudflareaccess.com e ACCESS_AUD = Application Audience
  // da aplicação que protege /api/ia. A chave da Anthropic é segredo: wrangler secret put ANTHROPIC_API_KEY
  // conferência das respostas (src/conferencia.js): todos com acesso à IA podem pedir; para restringir a uma lista,
  // segredo fora deste arquivo, que é público: wrangler secret put CONFERENCIA_EMAILS (e-mails separados por vírgula)
  "vars": { "ACCESS_TEAM": "icy-breeze-2aa0.cloudflareaccess.com", "ACCESS_AUD": "b9f953be729d05835209504ba7d3ee7c01cd9135dfa5182ebca9c7f3e323da13" },
  // bucket privado com os Parquet: só o Worker lê
  "r2_buckets": [{ "binding": "DADOS", "bucket_name": "lapam-finbra" }],
  "observability": { "enabled": true }
}
